[Unit]
Description=Health Auto Export MCP server (streamable-http, port 8766)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rafal/health-auto-export-api
# MCP przez streamable-http (localhost). Osobny venv-mcp - pakiet `mcp`
# konfliktuje wersyjnie ze starlette używanym przez webhook (health-api.service).
ExecStart=/home/rafal/health-auto-export-api/venv-mcp/bin/python mcp_server.py --http --host 127.0.0.1 --port 8766
Restart=always
RestartSec=5
TimeoutStopSec=20

# Logi do pliku, analogicznie do health-api.service (journald user bywa
# niepersystentny). Podgląd: tail -f mcp-server.log
StandardOutput=append:/home/rafal/health-auto-export-api/mcp-server.log
StandardError=append:/home/rafal/health-auto-export-api/mcp-server.log

# Podstawowy sandbox
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
